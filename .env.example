# ── Database ──────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/railway_db

# ── JWT ───────────────────────────────────────────────
# Generate a real secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── App ───────────────────────────────────────────────
APP_NAME=Railway Reservation System
DEBUG=True
